{
  // Keeps this checkout on the latest pushed code. Runs when the folder opens
  // (VS Code asks once to "Allow Automatic Tasks"), then pulls every minute.
  // --ff-only never merges or overwrites: if you have local edits to the same
  // files, it stops and says so instead of touching your work.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Keep code up to date",
      "type": "shell",
      "command": "while true; do git pull --ff-only --quiet && echo \"$(date +%H:%M) up to date\" || echo \"$(date +%H:%M) could not update: commit or stash your local changes\"; sleep 60; done",
      "windows": {
        "command": "while ($true) { git pull --ff-only --quiet; if ($LASTEXITCODE -eq 0) { Write-Host \"$(Get-Date -Format HH:mm) up to date\" } else { Write-Host \"$(Get-Date -Format HH:mm) could not update: commit or stash your local changes\" }; Start-Sleep -Seconds 60 }"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "panel": "dedicated" },
      "runOptions": { "runOn": "folderOpen" }
    }
  ]
}
