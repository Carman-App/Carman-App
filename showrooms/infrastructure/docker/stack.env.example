# Runtime environment for the API container. Never commit the filled-in copy.
NODE_ENV=production
APP_ENV=staging
TRUST_PROXY=1
JWT_ACCESS_SECRET=
DATA_ENCRYPTION_KEY=
POSTER_SIGNING_SECRET=
CORS_ORIGINS=http://localhost:3000
WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000
BCRYPT_ROUNDS=12
EMAIL_PROVIDER=console
MEDIA_PROVIDER=disabled
PAYMENTS_PROVIDER=disabled
