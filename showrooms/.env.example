# Each app reads its own .env file; copy the matching section.
#   apps/api/.env       <- API section
#   apps/web/.env.local <- Web section
#   apps/mobile/.env    <- Mobile section
#
# Never commit real values. Anything prefixed NEXT_PUBLIC_ or EXPO_PUBLIC_ is
# shipped to browsers/phones, so secrets must never use those prefixes.

# ---------------------------------------------------------------- API
NODE_ENV=development            # development | test | production
APP_ENV=development             # development | staging | production (deployment stage)
PORT=4000
LOG_LEVEL=info
TRUST_PROXY=0                   # proxy hops in front of the API (1 behind a single load balancer)

# docker compose (infrastructure/docker) gives you this replica set:
MONGODB_URI=mongodb://localhost:27017/showrooms?replicaSet=rs0&directConnection=true

# openssl rand -base64 48
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30
BCRYPT_ROUNDS=12

CORS_ORIGINS=http://localhost:3000   # comma-separated allowlist of web origins
WEB_URL=http://localhost:3000        # used in email links
COOKIE_DOMAIN=                       # e.g. .showrooms.co.ke when web and API share a parent domain
RATE_LIMIT_ENABLED=true

EMAIL_PROVIDER=console          # console (logs emails) | resend
RESEND_API_KEY=
EMAIL_FROM=Showrooms <no-reply@showrooms.co.ke>

# Used by `pnpm --filter @showrooms/api create-admin` only.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Shared with the web server (signs WhatsApp Status poster links). openssl rand -base64 48
POSTER_SIGNING_SECRET=
# 32 random bytes, base64 (encrypts ID numbers / KRA PINs). openssl rand -base64 32
DATA_ENCRYPTION_KEY=
PUBLIC_API_URL=http://localhost:4000   # how browsers/phones reach the API (local media URLs)
JOBS_ENABLED=true                      # run expiry/reconciliation jobs (enable on ONE instance)

# Media: cloudinary | local (development only, files on disk) | disabled
MEDIA_PROVIDER=local
MEDIA_LOCAL_DIR=.uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# M-Pesa Daraja (server only, never sent to clients). mpesa | disabled
PAYMENTS_PROVIDER=disabled
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=                # public HTTPS URL of POST /api/v1/payments/mpesa/callback
MPESA_CALLBACK_TOKEN=              # random secret appended as ?token=; openssl rand -hex 24
MPESA_CALLBACK_IPS=                # optional comma-separated Safaricom IPs
MPESA_VERIFY_WITH_QUERY=true       # confirm success callbacks with an STK query before activating

# Push notifications: expo | disabled
PUSH_PROVIDER=disabled
EXPO_ACCESS_TOKEN=

# ---------------------------------------------------------------- Web
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-only (not NEXT_PUBLIC): same value as the API's POSTER_SIGNING_SECRET
# POSTER_SIGNING_SECRET=
# API_INTERNAL_URL=http://api:4000/api/v1   # API address from the Next.js server, if different

# ---------------------------------------------------------------- Mobile
# 10.0.2.2 is the host machine from the Android emulator; use your LAN IP on a phone.
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000/api/v1
EXPO_PUBLIC_SITE_URL=http://localhost:3000
# EAS_PROJECT_ID=   # read by app.config.ts at build time; enables Expo push tokens
