# Copy to .env per app. Never commit real values.
# Server-only secrets must NOT use NEXT_PUBLIC_ or EXPO_PUBLIC_ prefixes.

# --- API (apps/api) ---
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/vehicle-marketplace
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
CORS_ORIGINS=http://localhost:3000
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
RESEND_API_KEY=
EXPO_ACCESS_TOKEN=

# --- Web (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Mobile (apps/mobile) ---
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000/api/v1
