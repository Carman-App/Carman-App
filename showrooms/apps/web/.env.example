# Browser-visible (never put secrets here)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only: same value as the API's POSTER_SIGNING_SECRET
POSTER_SIGNING_SECRET=
# Server-only: API base URL as seen from the Next.js server (defaults to NEXT_PUBLIC_API_URL)
API_INTERNAL_URL=
