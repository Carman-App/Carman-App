# Minimum to run the API locally. See ../../.env.example for every option.
MONGODB_URI=mongodb://localhost:27017/showrooms?replicaSet=rs0&directConnection=true
# openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-output-of-openssl-rand-base64-48
# openssl rand -base64 32
DATA_ENCRYPTION_KEY=
# openssl rand -base64 48 (same value in apps/web/.env.local)
POSTER_SIGNING_SECRET=
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000
EMAIL_PROVIDER=console
MEDIA_PROVIDER=local
PAYMENTS_PROVIDER=disabled
