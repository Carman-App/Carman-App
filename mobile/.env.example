# Carma mobile app settings.
# Copy to .env.local (or run `node scripts/setup-env.mjs` from the repo root,
# which adds anything missing without touching values you already have).
# Only EXPO_PUBLIC_* values reach the app, and they are visible to anyone who
# has the app: never put secrets here. For EAS builds, set them in the EAS
# environment instead.

# --- Server ----------------------------------------------------------------------
# The admin server's address. Keep localhost:4000 in development: on a phone
# or emulator the app swaps "localhost" for your computer's address (the one
# Expo serves from), so Expo Go on the same Wi-Fi works without editing this.
# Production: your API's https URL.
EXPO_PUBLIC_API_URL="http://localhost:4000"

# Development only: the demo account used when not signed in (must match
# admin DEV_ACCOUNT_ID). Leave it out of production builds.
EXPO_PUBLIC_DEV_ACCOUNT_ID="00000000-0000-4000-8000-000000000001"

# --- Sign in with Google / Apple (src/features/auth/signIn.ts, app.config.ts) ----
# Needs a development or store build, not Expo Go. The server must list the
# same ids (admin GOOGLE_CLIENT_IDS and APPLE_AUDIENCES).
EXPO_PUBLIC_IOS_BUNDLE_ID=""
EXPO_PUBLIC_ANDROID_PACKAGE=""
# Web client id: Google issues the ID token for this audience.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=""
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=""
# Reversed iOS client id, e.g. com.googleusercontent.apps.1234-abcd
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=""

# --- Crash and error reporting (src/lib/monitoring.ts) ----------------------------
# Off when empty.
EXPO_PUBLIC_SENTRY_DSN=""
# For uploading source maps in EAS builds (also set SENTRY_AUTH_TOKEN as an EAS secret).
SENTRY_ORG=""
SENTRY_PROJECT=""
