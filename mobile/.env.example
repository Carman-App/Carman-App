# Base URL of the admin/ Next.js app's /api/v1/* surface. Point this at
# wherever `npm run dev` (or a deployed instance) is listening.
#
# - Expo web (localhost:8974) can reach the admin server at localhost.
# - iOS Simulator can also reach localhost directly.
# - Android Emulator must use 10.0.2.2 instead of localhost.
# - A physical device (Expo Go / dev client) must use your machine's LAN IP,
#   e.g. http://192.168.0.100:4000 — localhost on a physical device means
#   the device itself, not your computer.
EXPO_PUBLIC_API_URL="http://localhost:4000"

# Fixed dev/demo Account id — must match admin/.env's DEV_ACCOUNT_ID (see
# admin/prisma/seed.ts). There is no real end-user auth yet (Apple/Google
# OAuth is a later phase), so every request identifies itself via the
# x-carma-account-id header using this value. See
# src/data/api/client.ts#getCurrentAccountId for the single place this is
# read — swapping in real auth later is a one-function change there.
EXPO_PUBLIC_DEV_ACCOUNT_ID="00000000-0000-4000-8000-000000000001"

# --- Below: not read by any code yet. Reserved for the later phase that
# implements real "Continue with Apple/Google" (the buttons exist on the
# Welcome screen today but aren't wired up). Client-side OAuth config only —
# the matching server-side secrets live in admin/.env.example.

# Google Sign-In client ids (from Google Cloud Console → OAuth 2.0 Client
# IDs — a separate id is required per platform).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID="replace-with-google-ios-client-id"
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID="replace-with-google-android-client-id"
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID="replace-with-google-web-client-id"

# Sign in with Apple needs no client-side key — it's enabled via the
# `expo-apple-authentication` config plugin + the app's own bundle id/
# entitlements in app.json, not an env var.
