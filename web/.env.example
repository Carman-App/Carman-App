# Fixed dev/demo Account id — must match admin/.env's DEV_ACCOUNT_ID (see
# admin/prisma/seed.ts). There is no real end-user auth yet, so every API
# request identifies itself with the x-carma-account-id header using this
# value. src/api/client.ts#getCurrentAccountId is the single place it's read.
VITE_DEV_ACCOUNT_ID="00000000-0000-4000-8000-000000000001"

# Where the admin/ app's /api/v1/* lives. Leave unset to call the same origin
# (/api/v1), which the dev server proxies to API_PROXY_TARGET below. Set it
# for a deployment where the API is on another origin (and add this app's
# origin to admin's CORS_ALLOWED_ORIGINS).
# VITE_API_URL="https://api.carma.example"

# Dev/preview server only: where `npm run dev` proxies /api/* to.
API_PROXY_TARGET="http://localhost:4000"
