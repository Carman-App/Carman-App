# Carma API + admin console settings.
# Copy to .env (or run `node scripts/setup-env.mjs` from the repo root, which
# adds anything missing without touching values you already have).
# Values in .env.local override .env. Never commit either file.
# Production values belong in your host's secret store — see DEPLOY.md.

# --- Database ----------------------------------------------------------------
# Postgres connection string used by the running server. In production,
# point it at the connection pooler (PgBouncer, transaction mode).
# Supabase: Project → Connect → "Transaction pooler" (port 6543), with your
# database password in place of [YOUR-PASSWORD] and ?sslmode=require at the end.
DATABASE_URL="postgresql://carma:carma@localhost:5432/carma"
# Direct (unpooled) connection for migrations (`prisma migrate deploy`).
# Leave empty when DATABASE_URL is already direct (local Postgres).
# Supabase: Connect → "Session pooler" (port 5432), with ?sslmode=require.
DIRECT_DATABASE_URL=""
# Connections each server instance keeps open (default 10).
DATABASE_POOL_MAX="10"
# Optional read replica for the console's reporting screens.
DATABASE_READ_URL=""

# --- Redis ---------------------------------------------------------------------
# Rate limits, caches and the background job queue. Required in production.
# Leave empty locally: everything falls back to in-process memory and jobs
# run inside the API.
REDIS_URL=""
# Jobs each worker process runs at once (npm run worker).
WORKER_CONCURRENCY="10"

# --- End-user sign-in (src/lib/auth/end-user.ts) -------------------------------
# Signs the app's 15-minute access tokens. At least 32 random characters
# (openssl rand -base64 48). Changing it signs everyone out.
AUTH_JWT_SECRET="replace-with-48-random-bytes-base64"
# Google: every OAuth client id the app signs in with (iOS, Android, web), comma-separated.
GOOGLE_CLIENT_IDS=""
# Apple: the iOS bundle id, plus a Services ID if Apple sign-in is offered on the web.
APPLE_AUDIENCES=""
# `npm run dev` only: accept the app's demo account (x-carma-account-id
# header) unless this is "false". Production builds never accept it.
ALLOW_DEV_ACCOUNT_HEADER="true"
# The demo account created by `npm run seed`. Must match the app's EXPO_PUBLIC_DEV_ACCOUNT_ID.
DEV_ACCOUNT_ID="00000000-0000-4000-8000-000000000001"

# --- Admin console ---------------------------------------------------------------
# Signs admin session cookies (openssl rand -base64 32).
SESSION_SECRET="replace-with-a-long-random-string"
# Admin logins are created and changed with `npm run create-admin`, which
# asks for the email and password. These are only read by
# `npm run create-admin -- --from-env` (unattended, e.g. Docker); leave them
# empty otherwise. Not read at runtime.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME=""
ADMIN_ROLE=""

# --- Public pages (/legal/privacy, /legal/terms, /legal/delete-account) ----
SUPPORT_EMAIL="support@carma.app"
COMPANY_NAME="Carma"

# --- Security --------------------------------------------------------------------
# Browser origins allowed to call /api/v1 (comma-separated). Empty in
# development allows any; in production only these. Native apps need none.
CORS_ALLOWED_ORIGINS=""
# Rate limits (src/lib/rate-limit.ts). Per minute; auth is per 5 minutes per IP.
RATE_LIMIT_API="600"
RATE_LIMIT_WRITE="120"
RATE_LIMIT_AUTH="30"
RATE_LIMIT_ANON="120"

# --- File storage (src/lib/storage.ts) --------------------------------------------
# A private S3-compatible bucket for document photos and PDFs. Set
# S3_ENDPOINT for Cloudflare R2 / MinIO; leave it empty for AWS S3.
S3_BUCKET=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""

# --- Subscriptions: App Store / Google Play through RevenueCat (src/lib/billing/store.ts)
# Secret API key (RevenueCat → Project settings → API keys → Secret, sk_…).
# The server reads what each account bought from RevenueCat with it.
REVENUECAT_SECRET_API_KEY=""
# Any long random string; set the same value as the Authorization header of
# RevenueCat's webhook (Integrations → Webhooks → URL
# https://<your-api>/api/v1/billing/revenuecat).
REVENUECAT_WEBHOOK_AUTH=""

# --- Push notifications (src/lib/notifications/push.ts) ------------------------
# Sent through Expo's push service; works with no settings. Set an access
# token only if "enhanced push security" is on for the project at expo.dev.
EXPO_ACCESS_TOKEN=""
# "off" stops all push sending (e.g. on a staging copy of production data).
PUSH_NOTIFICATIONS=""

# --- Assistant ----------------------------------------------------------------------
# Server-side only; the app never sees it. Without it the app answers on the phone.
ANTHROPIC_API_KEY=""

# --- Error monitoring (src/instrumentation.ts) -------------------------------------
# Off when empty.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"
SENTRY_RELEASE=""
SENTRY_TRACES_SAMPLE_RATE="0.05"

# --- Not used by any code yet -------------------------------------------------------
# Names reserved for integrations that are still no-ops (email and SMS
# notifications; card payments outside the app stores).
RESEND_API_KEY=""
EMAIL_FROM="Carma <notifications@carma.example>"
AFRICASTALKING_USERNAME=""
AFRICASTALKING_API_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
CLOUD_BILLING_API_KEY=""
