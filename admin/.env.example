# Postgres connection string for Prisma. Plug in your own instance (e.g. Neon,
# Supabase, Railway, or a local Postgres). Prisma 7 requires the pg driver
# adapter, so any standard postgresql:// connection string works.
DATABASE_URL="postgresql://user:password@localhost:5432/carma"

# Fixed id of the single demo Account/User/Garage created by `npm run seed`
# (prisma/seed.ts). There is no real end-user auth yet (see
# src/lib/api/auth.ts) and no POST /api/v1/account to create a fresh account
# from nothing, so the mobile app's onboarding flow bootstraps against this
# one pre-provisioned account via the x-carma-account-id header instead of
# creating a new one. Mobile reads the same value from its own
# EXPO_PUBLIC_DEV_ACCOUNT_ID env var — keep them in sync. Delete this whole
# mechanism once real Apple/Google auth lands (see AGENTS.md).
DEV_ACCOUNT_ID="00000000-0000-4000-8000-000000000001"

# Secret used to sign the admin session cookie (see src/lib/auth/session.ts).
# Generate one with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-string"

# Used by `npm run create-admin` (scripts/create-admin.ts) to create the
# first AdminUser. Not read at runtime by the app itself.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-now"
ADMIN_NAME="Admin"

# Object storage for VehicleDocument/Report files (src/lib/storage.ts).
# Works with AWS S3 or an S3-compatible service. Leave S3_ENDPOINT unset for
# real AWS S3; set it for Cloudflare R2 or other S3-compatible providers.
S3_BUCKET="carma-documents"
S3_REGION="auto"
S3_ACCESS_KEY_ID="replace-with-access-key-id"
S3_SECRET_ACCESS_KEY="replace-with-secret-access-key"
# S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"

# CORS for /api/v1/* (see src/proxy.ts). Leave unset in development to
# reflect back whatever Origin the mobile app's dev server sends. Set a
# comma-separated allowlist for a real deployment, e.g.:
# CORS_ALLOWED_ORIGINS="https://app.carma.example,https://staging.carma.example"

# Shared cache / rate-limiting / cross-instance coordination (Stage 2 of the
# scaling roadmap — see SCALABILITY_AUDIT.md). NOT read by any code yet:
# today's queue (src/lib/queue/queue.ts), idempotency keys
# (src/lib/idempotency.ts), rate limiting (src/lib/rateLimit.ts), and cache
# (src/lib/cache/inProcessCache.ts) are all genuinely-correct Postgres/
# in-process implementations for a single Next.js instance. Redis becomes
# worth adding — for sub-millisecond shared counters and a cache shared
# across instances — once this app runs as more than one Next.js instance,
# not before. Provision a real instance (Upstash, Redis Cloud, ElastiCache,
# etc.) when that horizontal-scaling step actually happens.
# REDIS_URL="rediss://default:replace-with-password@replace-with-host:6379"

# --- Below: not read by any code yet. Reserved for the later phases that
# implement src/lib/auth/provider.ts (real end-user auth) and
# src/lib/notifications/provider.ts (real email/SMS/push) — both are
# currently no-ops. Fill these in when those phases land; until then they're
# inert placeholders so the var names are settled and discoverable.

# Sign in with Apple. APPLE_CLIENT_ID is the Services ID (not the app's
# bundle id); APPLE_PRIVATE_KEY is the .p8 file's contents with real
# newlines escaped as \n.
APPLE_CLIENT_ID="replace-with-apple-services-id"
APPLE_TEAM_ID="replace-with-apple-team-id"
APPLE_KEY_ID="replace-with-apple-key-id"
APPLE_PRIVATE_KEY="replace-with-apple-p8-private-key-contents"

# Google Sign-In.
GOOGLE_CLIENT_ID="replace-with-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="replace-with-google-oauth-client-secret"

# Outbound email. Named for Resend; swap the var name (and the eventual
# provider implementation) if you use SES/SendGrid/Postmark/etc. instead.
RESEND_API_KEY="replace-with-resend-api-key"
EMAIL_FROM="Carma <notifications@carma.example>"

# Outbound SMS. Africa's Talking is the natural default given the
# Kenya-first region model (see src/types region defaults); swap for
# Twilio/etc. if you use a different provider.
AFRICASTALKING_USERNAME="replace-with-africastalking-username"
AFRICASTALKING_API_KEY="replace-with-africastalking-api-key"

# Push notifications to the Expo mobile app, sent server-side via
# expo-server-sdk against device push tokens the app registers. Generate at
# https://expo.dev/accounts/[account]/settings/access-tokens
EXPO_ACCESS_TOKEN="replace-with-expo-access-token"

# Payment processor (Money surface — Phase Two). Not read by any code yet:
# there is no real card-charging integration today, so MON-03 (failed
# payments), MON-06 (masked card brand/last4), and MON-07 (refund
# execution) all stay honest no-ops against Subscription/FailedPayment/
# RefundCredit rows until real credentials are supplied here. Named for
# Stripe; swap the var names (and the eventual provider implementation) if
# you use a different processor.
STRIPE_SECRET_KEY="replace-with-stripe-secret-key"
STRIPE_WEBHOOK_SECRET="replace-with-stripe-webhook-signing-secret"

# Error/exception tracking (System surface — Phase Three, OPS-01). Not read
# by any code yet: there is no APM/error-capture integration in this
# codebase (no Sentry SDK installed, no server-side exception hook wired),
# so OPS-01's error-rate/top-failures view stays an honest "not connected"
# state until real credentials are supplied here. Named for Sentry; swap the
# var names (and add @sentry/nextjs) if you use a different provider.
SENTRY_DSN="replace-with-sentry-dsn"
SENTRY_ENVIRONMENT="development"

# Cloud cost/billing API (System surface — Phase Three, OPS-07). Not read by
# any code yet: no cloud billing integration exists, so storage/processing
# cost trends stay an honest "not connected" state until a real
# provider-billing credential is supplied here (shape depends on which cloud
# host is used for Postgres/S3/compute — Neon, AWS, Cloudflare, etc. each
# have their own billing API).
CLOUD_BILLING_API_KEY="replace-with-cloud-billing-api-key"
