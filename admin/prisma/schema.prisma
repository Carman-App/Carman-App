// Carma — Prisma schema
//
// Models the full owner + workshop domain described in AGENTS.md/the product
// brief, plus the internal AdminUser used only by this admin panel.
//
// Design notes (read before extending):
// - Money fields use Decimal(12,2). Distances/odometer use Int (km).
// - Financial/history rows use soft delete (`deletedAt`) instead of hard
//   delete: fuel/service/repair/expense records, invoices, payments,
//   documents. Nothing should physically destroy vehicle history.
// - "Actor" columns (enteredByAccountId, approvedByAccountId, recordedByAccountId,
//   decidedByAccountId, invitedByAccountId, uploadedByAccountId,
//   generatedByAccountId, requestedByWorkshopMemberId, revokedByAccountId, ...)
//   are plain id columns, not enforced Prisma relations. They record "who did
//   this" without ballooning the relation graph with dozens of named
//   back-references on Account/WorkshopMember; AuditLog is the source of
//   truth for actor history. Structural relations that drive authorization
//   and cascades (ownership, membership, resource hierarchy) remain real FKs.
// - `usage` (plan usage/limits) is intentionally NOT a stored table — it is
//   computed on demand from real rows (vehicle counts, jobs this month, etc.)
//   in src/lib/limits.ts, per "plans/limits belong in the domain layer".
// - End-user (Owner/Mechanic) authentication is out of scope for this schema
//   revision — see User/Account below. AdminUser (internal admin login) is
//   deliberately separate and unaffected.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// Enums
// ============================================================================

