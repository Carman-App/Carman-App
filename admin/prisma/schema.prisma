// Generic two-person approval, reused by any dangerous action that needs a
// second admin's sign-off beyond a required reason (GAR-07 garage handover,
// MON-07 refunds above a threshold). One admin requests with a reason and an
// exact payload of what will execute; a *different* admin approves (or
// rejects); only then does the actual mutation run — enforced in
// src/lib/approvals.ts, never trust a client-supplied "approved" flag.
enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXECUTED
  CANCELLED
}

