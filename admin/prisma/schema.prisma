// PRIV-01 — the export itself is generated and downloaded synchronously (no
// job queue exists), so this is mostly a record of "this happened", not a
// long-lived queue state machine.
model DataExportRequest {
  id                 String           @id @default(cuid())
  accountId          String
  requestedByAdminId String
  reason             String
  status             DataExportStatus @default(GENERATED)
  recordCounts       Json?            @db.JsonB // summary of what was included, per model
  downloadedAt       DateTime?
  createdAt          DateTime         @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("data_export_requests")
}

// PRIV-02 (account deletion's printed retention rule) extends the existing
// ACCT-07 flow in src/app/(dashboard)/accounts/[id]/*.tsx — no new model.

// PRIV-03 — real gap: no consent-capture mechanism exists anywhere in the
// mobile app today (onboarding shows static "you agree to..." text with
// nothing recorded). Named PrivacyConsent (not Consent) to stay clearly
// distinct from the unrelated ConsentSession model above (SUP-03's "view as
// user" temporary-access consent). Empty until mobile onboarding is changed
// to POST into this.
model PrivacyConsent {
  id           String   @id @default(cuid())
  accountId    String
  purpose      String // e.g. "essential", "marketing", "analytics", "third_party_sharing" — a plain string, not an enum, so a new purpose never needs a migration
  granted      Boolean
  termsVersion String
  capturedAt   DateTime @default(now())
  source       String // e.g. "mobile_onboarding" — always empty in practice until that's built
  metadata     Json?    @db.JsonB

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([purpose])
  @@map("privacy_consents")
}

// PRIV-04 — the retention-window CONFIG and its purge log. "Next scheduled
// purge" is a real *computed* date (rule.updatedAt or last purge +
// retentionDays); nothing in this codebase actually executes a purge on
// schedule, since that needs the same job-queue prerequisite OPS-02/03
// lack. RetentionPurgeLog exists for when a real scheduled purge runs,
// and doubles as the place a one-off manual purge (if ever run by hand)
// would log what it removed.
model RetentionRule {
  id               String   @id @default(cuid())
  dataClass        String   @unique // e.g. "fuel_records", "documents", "audit_logs", "deleted_accounts"
  retentionDays    Int
  description      String?
  updatedByAdminId String?
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())

  purgeLogs RetentionPurgeLog[]

  @@map("retention_rules")
}

model RetentionPurgeLog {
  id                 String   @id @default(cuid())
  ruleId             String
  ranAt              DateTime @default(now())
  recordsRemoved     Int
  notes              String?
  performedByAdminId String? // null = would-be scheduled/system execution — always null today since no scheduler exists

  rule RetentionRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@map("retention_purge_logs")
}

// PRIV-05 (masking + reveal-with-reason access logging) reuses the existing
// AuditLog table (see src/lib/audit.ts) exactly like AUD-06 — no new model.

// ============================================================================
// End-user sign-in (Google / Apple)
// ============================================================================

enum AuthProviderKind {
  GOOGLE
  APPLE
}

// One row per provider login linked to a person. `subject` is the provider's
// stable "sub" claim, never the email (emails change; Apple relays them).
model AuthIdentity {
  id         String           @id @default(cuid())
  userId     String
  provider   AuthProviderKind
  subject    String
  email      String?
  createdAt  DateTime         @default(now())
  lastUsedAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@index([userId])
  @@map("auth_identities")
}

// Long-lived refresh tokens for the mobile app. Only a SHA-256 hash is
// stored. Each refresh rotates the token; presenting an already-used token
// revokes its whole family (theft detection). Access tokens are short-lived
// signed JWTs and are never stored.
model EndUserRefreshToken {
  id            String    @id @default(cuid())
  accountId     String
  familyId      String
  tokenHash     String    @unique
  expiresAt     DateTime
  usedAt        DateTime?
  revokedAt     DateTime?
  revokedReason String?
  userAgent     String?
  createdAt     DateTime  @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([familyId])
  @@map("end_user_refresh_tokens")
}
