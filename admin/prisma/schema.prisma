// CFG-06/07 — generic draft/publish/diff/version-history/revert mechanism,
// shared by whichever of Country/PlanPrice/ConfigList/FeatureFlag/
// SubscriptionRules a screen applies it to, rather than five bespoke
// versioning implementations. A DRAFT row stages a full snapshot of the
// object's editable fields; publishing copies that payload into the live
// table (Country/PlanPrice/etc.) and flips this row to PUBLISHED, stamping
// who/when and (where cheaply computable) how many accounts it touches.
// Diffing is done in application code between a DRAFT's payload and the
// most recent PUBLISHED row for the same (objectType, objectKey). Revert
// creates a new PUBLISHED row copying an older payload — history is never
// mutated in place, matching AuditLog's append-only convention.
model ConfigVersion {
  id                   String              @id @default(cuid())
  objectType           ConfigObjectType
  objectKey            String // e.g. country code, "planId:currency", list key, flag key, "global" for subscription rules
  payload              Json                @db.JsonB
  status               ConfigVersionStatus @default(DRAFT)
  note                 String?
  accountsTouchedCount Int? // computed at publish time; not cheaply recomputable after the fact, so stored
  createdByAdminId     String
  createdAt            DateTime            @default(now())
  publishedByAdminId   String?
  publishedAt          DateTime?

  @@index([objectType, objectKey])
  @@index([status])
  @@map("config_versions")
}

// CFG-08 — subscription/trial rules as data, applied to new subscriptions
// only unless a screen states otherwise. Single global row (key = "global")
// today; the shape allows per-plan overrides later without a breaking change.
model SubscriptionRules {
  id                  String   @id @default(cuid())
  key                 String   @unique @default("global")
  trialDays           Int      @default(14)
  graceDays           Int      @default(7)
  dunningScheduleDays Int[]    @default([1, 3, 7])
  defaultSeatLimit    Int?
  updatedByAdminId    String?
  updatedAt           DateTime @updatedAt
  createdAt           DateTime @default(now())

  @@map("subscription_rules")
}

